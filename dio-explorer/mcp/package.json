{
  "name": "dio-explorer-mcp",
  "version": "0.1.0",
  "description": "MCP server for DIO Explorer — exposes formations, challenges and certificates over stdio or HTTP with API-key / Bearer-token auth",
  "type": "module",
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "start:stdio": "node build/index.js",
    "start:http": "DIO_TRANSPORT=http node build/index.js"
  },
  "bin": {
    "dio-explorer-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^4.19.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  }
}
